---
interface Props {
	title: string;
	comment?: string;
	id?: string;
}

const { title, comment, id } = Astro.props;
---

<div class="mb-10">
	<p class="font-mono text-xs uppercase tracking-widest text-muted-foreground" aria-hidden="true">
		{comment || title}
	</p>
	<h2 id={id} class="mt-2 text-2xl font-semibold tracking-tight text-foreground sm:text-3xl">
		{title}
	</h2>
</div>
