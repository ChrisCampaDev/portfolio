---
interface Props {
	title: string;
	comment?: string;
	id?: string;
}

const { title, comment, id } = Astro.props;
---

<div class="mb-8">
	<p class="font-mono text-sm text-coder-muted" aria-hidden="true">
		// --- {comment || title} ---
	</p>
	<h2
		id={id}
		class="mt-1 font-mono text-2xl font-bold tracking-tight text-foreground sm:text-3xl"
	>
		{title}
	</h2>
	<div class="mt-4 h-px w-24 bg-coder-edge" aria-hidden="true"></div>
</div>
