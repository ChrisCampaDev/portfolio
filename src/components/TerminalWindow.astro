---
interface Props {
	filename: string;
	dots?: boolean;
	class?: string;
}

const { filename, dots = true, class: className = "" } = Astro.props;
---

<div
	class:list={[
		"overflow-hidden rounded-xl border border-coder-edge bg-coder-panel",
		className,
	]}
>
	<div
		class="flex items-center gap-3 border-b border-coder-edge bg-coder-panel px-4 py-2.5"
	>
		{
			dots && (
				<div class="flex shrink-0 gap-1.5" aria-hidden="true">
					<span class="size-3 rounded-full bg-coder-red"></span>
					<span class="size-3 rounded-full bg-coder-yellow"></span>
					<span class="size-3 rounded-full bg-coder-accent"></span>
				</div>
			)
		}
		<span class="min-w-0 truncate font-mono text-xs text-muted-foreground">
			{filename}
		</span>
		<span class="ml-auto hidden shrink-0 font-mono text-[10px] uppercase tracking-wider text-coder-muted sm:inline">
			bash
		</span>
	</div>
	<div class="p-5 sm:p-7">
		<slot />
	</div>
</div>
