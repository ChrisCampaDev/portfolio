---
import TerminalWindow from "@/components/TerminalWindow.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import StackSection from "@/components/sections/Skills/StackSection.astro";
import { getTexts } from "@/utils/i18n";

const texts = getTexts(Astro);
---

<section id="skills" class="scroll-mt-24 py-12 sm:py-16" aria-labelledby="skills-heading">
	<div class="mx-auto max-w-6xl px-4">
		<TerminalWindow filename="skills.tsx">
			<SectionHeader id="skills-heading" title={texts.skills.title} comment="skills.tsx" />
			<p class="mb-4 text-sm text-muted-foreground">
				{texts.skills.stack_description}
			</p>
			<StackSection />
			<p class="mt-4 font-mono text-xs text-coder-muted">
				{texts.skills.filter_hint}
			</p>
		</TerminalWindow>
	</div>
</section>
