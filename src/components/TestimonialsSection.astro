---
import SectionHeader from "@/components/SectionHeader.astro";
import { getTestimonials } from "@/content/testimonials";
import { getTexts } from "@/utils/i18n";

const texts = getTexts(Astro);
const items = getTestimonials(Astro);
---

<section id="testimonials" class="scroll-mt-24 py-12 sm:py-16" aria-labelledby="testimonials-heading">
	<div class="mx-auto max-w-6xl px-4">
		<SectionHeader id="testimonials-heading" title={texts.testimonials.title} comment="testimonials" />
		<p class="mb-10 max-w-xl text-muted-foreground">{texts.testimonials.subtitle}</p>
		{
			items.length === 0 ? (
				<p class="text-muted-foreground">{texts.testimonials.title}: []</p>
			) : (
				<div class="grid grid-cols-1 gap-x-14 gap-y-10 md:grid-cols-2">
					{items.map((item) => (
						<figure>
							<blockquote class="text-sm leading-relaxed text-foreground">
								"{item.quote}"
							</blockquote>
							<figcaption class="mt-3 text-sm">
								<span class="font-medium text-foreground">{item.author}</span>
								<span class="text-muted-foreground">
									{item.role}
									{item.company ? ` · ${item.company}` : ""}
								</span>
							</figcaption>
						</figure>
					))}
				</div>
			)
		}
	</div>
</section>
