---
import TerminalWindow from "@/components/TerminalWindow.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import {
	Tabs,
	TabsList,
	TabsTrigger,
	TabsContent,
} from "@/components/starwind/tabs";
import { getExperience } from "@/content/experience";
import { getTexts } from "@/utils/i18n";

const texts = getTexts(Astro);
const items = getExperience(Astro);

const OTHER_YEAR = "__other__";

const yearKey = (item: (typeof items)[number]) =>
	item.year != null ? String(item.year) : OTHER_YEAR;

const years = Array.from(new Set(items.map(yearKey))).sort((a, b) => {
	const aNum = Number(a);
	const bNum = Number(b);
	if (!Number.isNaN(aNum) && !Number.isNaN(bNum)) return bNum - aNum;
	return b.localeCompare(a);
});

const yearLabel = (year: string) =>
	year === OTHER_YEAR ? texts.experience.year_other : year;
---

<section id="experience" class="scroll-mt-24 py-12 sm:py-16" aria-labelledby="experience-heading">
	<div class="mx-auto max-w-6xl px-4">
		<TerminalWindow filename="experience.ts">
			<SectionHeader id="experience-heading" title={texts.experience.title} comment="Experiencia" />
			{
				items.length === 0 ? (
					<p class="text-muted-foreground">
						{texts.experience.title}: <span class="font-mono text-coder-muted">[]</span>
					</p>
				) : (
					<Tabs defaultValue={years[0]}>
						<TabsList class="mb-6 font-mono">
							{years.map((year) => (
								<TabsTrigger value={year}>{yearLabel(year)}</TabsTrigger>
							))}
						</TabsList>
						{years.map((year) => (
							<TabsContent value={year}>
								<ol class="flex flex-col gap-6">
									{items
										.filter((item) => yearKey(item) === year)
										.map((item) => (
											<li>
												<article class="rounded-lg border border-coder-edge bg-card p-5 transition-colors hover:border-coder-accent/60 sm:p-6">
													<div class="mb-2 flex flex-wrap items-start justify-between gap-3">
														<h3 class="font-mono text-lg font-semibold text-foreground">
															{item.company}
														</h3>
														<span class="shrink-0 rounded border border-coder-edge px-2 py-0.5 font-mono text-xs text-coder-muted">
															{item.date}
														</span>
													</div>
													<p class="text-sm leading-relaxed text-muted-foreground">
														{item.description}
													</p>
													{
														item.projects.length > 0 && (
															<ul class="mt-5 flex flex-col gap-3">
																{item.projects.map((project) => (
																	<li class="flex gap-3">
																		<span
																			class="mt-0.5 shrink-0 font-mono text-coder-accent"
																			aria-hidden="true"
																		>
																			▸
																		</span>
																		<div>
																			<h4 class="font-mono text-sm font-semibold text-foreground">
																				{project.title}
																			</h4>
																			<p class="mt-0.5 text-sm text-muted-foreground">
																				{project.description}
																			</p>
																		</div>
																	</li>
																))}
															</ul>
														)
													}
												</article>
											</li>
										))}
								</ol>
							</TabsContent>
						))}
					</Tabs>
				)
			}
		</TerminalWindow>
	</div>
</section>
