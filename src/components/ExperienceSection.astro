---
import SectionHeader from "@/components/SectionHeader.astro";
import { getExperience } from "@/content/experience";
import { getTexts } from "@/utils/i18n";

const texts = getTexts(Astro);
const items = getExperience(Astro);

const OTHER_YEAR = "__other__";

const yearKey = (item: (typeof items)[number]) =>
	item.year != null ? String(item.year) : OTHER_YEAR;

const years = Array.from(new Set(items.map(yearKey))).sort((a, b) => {
	const aNum = Number(a);
	const bNum = Number(b);
	if (!Number.isNaN(aNum) && !Number.isNaN(bNum)) return bNum - aNum;
	return b.localeCompare(a);
});

const yearLabel = (year: string) =>
	year === OTHER_YEAR ? texts.experience.year_other : year;
---

<section id="experience" class="scroll-mt-24 py-12 sm:py-16" aria-labelledby="experience-heading">
	<div class="mx-auto max-w-6xl px-4">
		<SectionHeader id="experience-heading" title={texts.experience.title} comment="experience" />
		{
			items.length === 0 ? (
				<p class="text-muted-foreground">{texts.experience.title}: []</p>
			) : (
				<div class="flex flex-col gap-14">
					{years.map((year) => (
						<div>
							<p class="mb-5 font-mono text-xs uppercase tracking-widest text-muted-foreground">
								{yearLabel(year)}
							</p>
							<ol class="flex flex-col gap-10 border-l border-border pl-6">
								{items
									.filter((item) => yearKey(item) === year)
									.map((item) => (
										<li class="relative">
											<span
												class="absolute -left-[26px] top-1.5 size-2 rounded-full border border-border bg-background"
												aria-hidden="true"
											></span>
											<article>
												<div class="mb-1 flex flex-wrap items-baseline justify-between gap-2">
													<div>
														<h3 class="text-lg font-semibold text-foreground">
															{item.company}
														</h3>
														{item.role && (
															<p class="mt-0.5 text-sm text-muted-foreground">
																{item.role}
															</p>
														)}
													</div>
													<span class="text-sm text-muted-foreground">{item.date}</span>
												</div>
												<p class="max-w-3xl text-sm leading-relaxed text-muted-foreground">
													{item.description}
												</p>
												{
													item.projects.length > 0 && (
														<ul class="mt-4 flex max-w-3xl flex-col gap-3">
															{item.projects.map((project) => (
																<li class="flex gap-3">
																	<span
																		class="mt-0.5 shrink-0 text-muted-foreground"
																		aria-hidden="true"
																	>
																		–
																	</span>
																	<div>
																		<h4 class="text-sm font-medium text-foreground">
																			{project.title}
																		</h4>
																		<p class="mt-0.5 text-sm text-muted-foreground">
																			{project.description}
																		</p>
																	</div>
																</li>
															))}
														</ul>
													)
												}
											</article>
										</li>
									))}
							</ol>
						</div>
					))}
				</div>
			)
		}
	</div>
</section>
