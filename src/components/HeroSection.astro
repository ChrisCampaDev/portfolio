---
import GitHubIcon from "@/components/icons/social/GitHubIcon.astro";
import LinkedInIcon from "@/components/icons/social/LinkedInIcon.astro";
import WhatsAppIcon from "@/components/icons/social/WhatsAppIcon.astro";
import { Button } from "@/components/starwind/button";
import { getProfile, getContact } from "@/content/profile";
import { getTexts } from "@/utils/i18n";

const texts = getTexts(Astro);
const profile = getProfile(Astro);
const contact = getContact(Astro);
const portrait = "/portfolio/christian-campa-profile.jpeg";
---

<section
	id="home"
	class="scroll-mt-24 py-16 sm:py-24"
	aria-labelledby="hero-heading"
>
	<div class="mx-auto grid max-w-6xl items-center gap-12 px-4 lg:grid-cols-[1.4fr_1fr]">
		<div>
			<p class="font-mono text-xs uppercase tracking-widest text-muted-foreground">
				{texts.hero.hello}
			</p>
			<h1
				id="hero-heading"
				class="mt-3 text-4xl font-semibold tracking-tight text-foreground sm:text-5xl lg:text-6xl"
			>
				{profile.name}
			</h1>
			<p class="mt-3 text-xl text-muted-foreground sm:text-2xl">
				{profile.role}
			</p>
			<p class="mt-5 max-w-xl text-muted-foreground">{profile.about}</p>

			<div class="mt-6 flex items-center gap-2 text-sm text-muted-foreground">
				<span class="relative flex size-2 shrink-0" aria-hidden="true">
					<span class="animate-status-pulse absolute inline-flex h-full w-full rounded-full bg-coder-accent"></span>
					<span class="relative inline-flex size-2 rounded-full bg-coder-accent"></span>
				</span>
				<span>{profile.availability}</span>
			</div>

			<div class="mt-8 flex flex-wrap items-center gap-3">
				<Button
					href={contact.cv}
					target="_blank"
					rel="noopener noreferrer"
					variant="primary"
					size="lg"
				>
					{texts.hero.cta_cv}
				</Button>
				<Button
					href={`#contact`}
					variant="ghost"
					size="lg"
				>
					{texts.hero.cta_contact}
				</Button>
			</div>

			<div class="mt-10">
				<p class="mb-3 font-mono text-xs uppercase tracking-widest text-muted-foreground">
					{texts.hero.connect}
				</p>
				<div class="flex items-center gap-3">
					<GitHubIcon href={contact.github} />
					<LinkedInIcon href={contact.linkedin} />
					<WhatsAppIcon href={`https://wa.me/${contact.whatsapp}`} />
				</div>
			</div>
		</div>

		<div class="lg:pl-6">
			<img
				src={portrait}
				alt={texts.hero.profileAlt}
				width="400"
				height="400"
				loading="eager"
				class="mx-auto aspect-square w-full max-w-xs rounded-2xl border border-border object-cover lg:max-w-sm"
			/>
		</div>
	</div>
</section>
