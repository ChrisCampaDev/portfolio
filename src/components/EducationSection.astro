---
import TerminalWindow from "@/components/TerminalWindow.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import { getEducation } from "@/content/education";
import { getTexts } from "@/utils/i18n";

const texts = getTexts(Astro);
const items = getEducation(Astro);
---

<section id="education" class="scroll-mt-24 py-12 sm:py-16" aria-labelledby="education-heading">
	<div class="mx-auto max-w-6xl px-4">
		<TerminalWindow filename="education.json">
			<SectionHeader id="education-heading" title={texts.education.title} comment="education.json" />
			<p class="mb-8 text-muted-foreground">{texts.education.subtitle}</p>
			{
				items.length === 0 ? (
					<p class="text-muted-foreground">
						{texts.education.title}: <span class="font-mono text-coder-muted">[]</span>
					</p>
				) : (
					<div class="grid grid-cols-1 gap-6 md:grid-cols-2">
						{items.map((item) => (
							<article class="rounded-lg border border-coder-edge bg-card p-5 transition-colors hover:border-coder-accent/60 sm:p-6">
								<div class="mb-2 flex flex-wrap items-start justify-between gap-3">
									<h3 class="font-mono text-base font-semibold text-foreground">
										{item.institution}
									</h3>
									<span class="shrink-0 rounded border border-coder-edge px-2 py-0.5 font-mono text-xs text-coder-muted">
										{item.date}
									</span>
								</div>
								<p class="font-mono text-sm text-coder-accent">{item.degree}</p>
								{
									item.description && (
										<p class="mt-2 text-sm text-muted-foreground">
											{item.description}
										</p>
									)
								}
							</article>
						))}
					</div>
				)
			}
		</TerminalWindow>
	</div>
</section>
