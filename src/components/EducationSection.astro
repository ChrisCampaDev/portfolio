---
import SectionHeader from "@/components/SectionHeader.astro";
import { getEducation } from "@/content/education";
import { getTexts } from "@/utils/i18n";

const texts = getTexts(Astro);
const items = getEducation(Astro);
---

<section id="education" class="scroll-mt-24 py-12 sm:py-16" aria-labelledby="education-heading">
	<div class="mx-auto max-w-6xl px-4">
		<SectionHeader id="education-heading" title={texts.education.title} comment="education" />
		<p class="mb-10 max-w-xl text-muted-foreground">{texts.education.subtitle}</p>
		{
			items.length === 0 ? (
				<p class="text-muted-foreground">{texts.education.title}: []</p>
			) : (
				<ul class="flex flex-col gap-8">
					{items.map((item) => (
						<li>
							<article>
								<div class="mb-1 flex flex-wrap items-baseline justify-between gap-2">
									<h3 class="text-lg font-semibold text-foreground">
										{item.institution}
									</h3>
									<span class="text-sm text-muted-foreground">{item.date}</span>
								</div>
								<p class="text-sm font-medium text-foreground">{item.degree}</p>
								{
									item.description && (
										<p class="mt-1 max-w-3xl text-sm text-muted-foreground">
											{item.description}
										</p>
									)
								}
							</article>
						</li>
					))}
				</ul>
			)
		}
	</div>
</section>
