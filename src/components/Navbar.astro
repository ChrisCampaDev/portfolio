---
import En from "@/components/icons/flags/en.astro";
import Es from "@/components/icons/flags/es.astro";
import IconSun from "@/components/icons/themes/IconSun.astro";
import IconMoon from "@/components/icons/themes/IconMoon.astro";
import { getTexts, getLocaleFromAstro } from "@/utils/i18n";
import { getContact } from "@/content/profile";

const texts = getTexts(Astro);
const currentLocale = getLocaleFromAstro(Astro);
const isEnglish = currentLocale === "en";
const contact = getContact();

const currentPath = Astro.url.pathname;
const pathWithoutLocale = currentPath.replace(/^\/portfolio\/?(en\/?)?/, "");
const baseUrl = pathWithoutLocale || "";
const spanishUrl = `/portfolio${baseUrl ? "/" + baseUrl : ""}`;
const englishUrl = `/portfolio/en${baseUrl ? "/" + baseUrl : ""}`;
const homeHref = isEnglish ? englishUrl : spanishUrl;

const links = [
	{ href: `${homeHref}#home`, label: texts.nav.home },
	{ href: `${homeHref}#experience`, label: texts.nav.experience },
	{ href: `${homeHref}#skills`, label: texts.nav.skills },
	{ href: `${homeHref}#projects`, label: texts.nav.projects },
	{ href: `${homeHref}#education`, label: texts.nav.education },
	{ href: `${homeHref}#testimonials`, label: texts.nav.testimonials },
	{ href: `${homeHref}#contact`, label: texts.nav.contact },
];

const linkClass =
	"rounded px-2 py-1 font-mono text-sm transition-colors hover:text-coder-accent focus-visible:ring-2 focus-visible:ring-coder-accent/60 focus-visible:outline-none";
---

<nav
	class="sticky top-0 z-20 border-b border-coder-edge bg-background/85 backdrop-blur"
	role="navigation"
	aria-label="Main navigation"
>
	<div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-2 px-4 py-3">
		<a
			href={homeHref}
			class="font-mono text-base font-semibold text-foreground transition-colors hover:text-coder-accent"
			aria-label="Home"
		>
			<span class="text-coder-muted" aria-hidden="true">$</span>
			<span class="text-coder-accent" aria-hidden="true">~/</span>chriscampadev
		</a>

		<div class="hidden items-center gap-1 md:flex">
			{
				links.map((link) => (
					<a href={link.href} class={linkClass}>
						<span class="text-coder-muted" aria-hidden="true">cd</span>
						<span class="text-foreground">/{link.label}</span>
					</a>
				))
			}
		</div>

		<div class="flex items-center gap-1.5">
			<a
				href={contact.cv}
				download
				class="hidden rounded-md border border-coder-accent px-3 py-1.5 font-mono text-sm text-coder-accent transition-colors hover:bg-coder-accent/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-coder-accent/60 md:inline-flex"
			>
				{texts.nav.cv}
			</a>

			<a
				href={isEnglish ? spanishUrl : englishUrl}
				class="rounded-lg p-2 text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-coder-accent/60"
				aria-label={texts.nav.switch}
				title={texts.nav.switch}
			>
				<Es
					class={`h-5 w-5 ${isEnglish ? "" : "hidden"}`}
					title="Español"
				/>
				<En
					class={`h-5 w-5 ${isEnglish ? "hidden" : ""}`}
					title="English"
				/>
			</a>

			<button
				type="button"
				id="theme-toggle-button"
				class="rounded-lg p-2 text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-coder-accent/60"
				aria-label={texts.nav.theme}
				title={texts.nav.theme}
			>
				<IconSun
					id="theme-toggle-light-icon"
					class="h-5 w-5"
					aria-hidden="true"
				/>
				<IconMoon
					id="theme-toggle-dark-icon"
					class="hidden h-5 w-5"
					aria-hidden="true"
				/>
			</button>

			<button
				type="button"
				id="mobile-menu-button"
				class="rounded-lg p-2 text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-coder-accent/60 md:hidden"
				aria-controls="mobile-menu"
				aria-expanded="false"
			>
				<span class="sr-only">{texts.nav.menu_open}</span>
				<svg
					class="h-5 w-5"
					aria-hidden="true"
					xmlns="http://www.w3.org/2000/svg"
					fill="none"
					viewBox="0 0 24 24"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<line x1="4" x2="20" y1="6" y2="6"></line>
					<line x1="4" x2="20" y1="12" y2="12"></line>
					<line x1="4" x2="20" y1="18" y2="18"></line>
				</svg>
			</button>
		</div>
	</div>

	<div id="mobile-menu" class="hidden border-t border-coder-edge md:hidden">
		<ul class="mx-auto flex max-w-6xl flex-col gap-1 px-4 py-3">
			{
				links.map((link) => (
					<li>
						<a
							href={link.href}
							class="block rounded px-2 py-2 font-mono text-sm text-foreground transition-colors hover:text-coder-accent"
						>
							<span class="text-coder-muted" aria-hidden="true">cd</span>
							<span class="text-foreground">/{link.label}</span>
						</a>
					</li>
				))
			}
			<li class="pt-2">
				<a
					href={contact.cv}
					download
					class="inline-flex w-full items-center justify-center rounded-md border border-coder-accent px-3 py-2 font-mono text-sm text-coder-accent transition-colors hover:bg-coder-accent/10"
				>
					{texts.nav.cv}
				</a>
			</li>
		</ul>
	</div>
</nav>

<script is:inline define:vars={{ menuOpenText: texts.nav.menu_open, menuCloseText: texts.nav.menu_close }}>
	function syncThemeIcons() {
		const sunIcon = document.getElementById("theme-toggle-light-icon");
		const moonIcon = document.getElementById("theme-toggle-dark-icon");
		const isDark = document.documentElement.classList.contains("dark");
		if (sunIcon) sunIcon.classList.toggle("hidden", isDark);
		if (moonIcon) moonIcon.classList.toggle("hidden", !isDark);
	}

	document.addEventListener("DOMContentLoaded", function () {
		const themeBtn = document.getElementById("theme-toggle-button");
		const mobileMenuButton = document.getElementById("mobile-menu-button");
		const mobileMenu = document.getElementById("mobile-menu");

		function initThemeToggle() {
			syncThemeIcons();
			if (themeBtn) {
				themeBtn.addEventListener("click", function () {
					const isDark = document.documentElement.classList.contains("dark");
					const next = isDark ? "light" : "dark";
					document.documentElement.classList.toggle("dark", next === "dark");
					localStorage.setItem("colorTheme", next);
					syncThemeIcons();
				});
			}
		}

		function initMobileMenu() {
			if (mobileMenuButton && mobileMenu) {
				mobileMenuButton.addEventListener("click", function () {
					const isExpanded =
						this.getAttribute("aria-expanded") === "true";
					this.setAttribute("aria-expanded", String(!isExpanded));
					mobileMenu.classList.toggle("hidden");
					const srText = this.querySelector(".sr-only");
					if (srText) {
						srText.textContent = isExpanded
							? menuOpenText
							: menuCloseText;
					}
				});
			}
		}

		function initLangPreference() {
			const langLinks = document.querySelectorAll(
				'a[title="Español"], a[title="English"]',
			);
			langLinks.forEach((link) => {
				link.addEventListener("click", function () {
					const href = this.getAttribute("href");
					if (href) {
						localStorage.setItem(
							"preferredLanguage",
							href.includes("/en/") ? "en" : "es",
						);
					}
				});
			});
		}

		initThemeToggle();
		initMobileMenu();
		initLangPreference();
	});

	document.addEventListener("astro:after-swap", function () {
		syncThemeIcons();
	});
</script>
