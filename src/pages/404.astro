---
import Button from "@/components/starwind/button";
import Layout from "@/layouts/layout.astro";
import { getTextsByLocale } from "@/utils/i18n";

// GitHub Pages serves the same 404.html for every missing path, so the locale
// is detected client-side from the URL instead of the build-time route.
const es704 = getTextsByLocale("es").notfound;
const en704 = getTextsByLocale("en").notfound;
---

<Layout desc={es704.description} title={es704.title}>
	<div
		class="flex flex-col items-center justify-center min-h-[60vh] text-center px-4"
	>
		<div class="max-w-md space-y-6">
			<div class="text-9xl font-bold text-gray-800 dark:text-gray-200">404</div>
			<h1 id="nf-heading" class="text-3xl font-bold text-gray-800 dark:text-gray-200">
				{es704.heading}
			</h1>
			<p id="nf-text" class="text-lg text-gray-600 dark:text-gray-400">
				{es704.text}
			</p>
			<Button variant="primary" class="mt-4">
				<a id="nf-home" href="/portfolio"> {es704.button}</a>
			</Button>
		</div>
	</div>
</Layout>

<script define:vars={{ en704 }}>
	if (location.pathname.includes("/en/")) {
		document.documentElement.lang = "en";
		document.title = en704.title;
		const heading = document.getElementById("nf-heading");
		const text = document.getElementById("nf-text");
		const button = document.getElementById("nf-home");
		if (heading) heading.textContent = en704.heading;
		if (text) text.textContent = en704.text;
		if (button) button.textContent = ` ${en704.button}`;
	}
</script>
